# Environment Configuration for MEMOGRAM Backend

# Project & Environment
PROJECT_NAME="MEMOGRAM"
ENVIRONMENT="development"
DEBUG=True

# Database (PostgreSQL / SQLite)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/memogram_db"

# JWT Security
JWT_SECRET="your_jwt_secret_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth (for Patient & Caretaker authentication)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5173","http://localhost:8080"]

# Server Port
PORT=8000
HOST="0.0.0.0"

# Google Gemini AI Configuration (Game Content & Conversational Layer)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_VOICE_MODEL="gemini-2.0-flash"

# Sarvam AI Configuration (Speech-To-Text with Saaras v3 & Translation)
# API key for Sarvam AI (Saaras v3 STT & Mayura translation)
SARVAM_API_KEY=""

# Indic Parler-TTS Configuration (Active TTS Provider for Indian Languages)
# Enable Indic Parler-TTS for regional speech synthesis (Assamese, Bodo, Manipuri, Hindi, English)
INDIC_PARLER_TTS_ENABLED=true
INDIC_PARLER_TTS_MODEL="ai4bharat/indic-parler-tts"
# URL of local Indic Parler-TTS sidecar server or hosted inference endpoint
INDIC_PARLER_TTS_ENDPOINT="http://localhost:8001/synthesize"
# Optional: API key/token for hosted inference endpoint if required
INDIC_PARLER_TTS_API_KEY=""

# Bhashini / ULCA Configuration (Optional / Inactive - not in active voice execution path)
# User ID for MeitY Bhashini platform (if retained for legacy experiments)
BHASHINI_USER_ID=""
# Inference API key for Bhashini pipeline requests
BHASHINI_API_KEY=""
# Optional: Specific pipeline ID for Bhashini
BHASHINI_PIPELINE_ID=""
# Optional: Custom inference URL
BHASHINI_INFERENCE_URL=""

# Additional TTS Provider Credentials (Azure Speech)
TTS_PROVIDER_API_KEY=""
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="eastus"
